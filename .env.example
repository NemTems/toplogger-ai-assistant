# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# Tokens live in the OS keychain via `keyring`, not here (AGENTS.md hard rule 1).
# The single exception is the one-time bootstrap at the bottom of this file.

# Gym to sync. Defaults to Falkors, whose ID is already public in
# docs/PROJECT_CONTEXT.md. Override to point at a different gym.
TOPLOGGER_GYM_ID=6k5d6kkbrp6y4rqmj84ip

# Your own TopLogger user ID, needed for the authenticated history sync.
# Personal data: it has no default in config.py and must stay out of git.
# TOPLOGGER_USER_ID=

# Max requests/second to TopLogger. 1.0 is a hard ceiling, not a suggestion —
# config.py rejects anything above it (politeness rule). Lower is fine.
TOPLOGGER_RATE_LIMIT_PER_SECOND=1.0

# Where raw snapshots and the SQLite DB live, relative to the repo root.
# Gitignored; never commit its contents.
TOPLOGGER_DATA_DIR=data

# --- One-time bootstrap ------------------------------------------------------
# Paste your refresh token here ONCE to hand it to the keychain, then delete the
# line. Get it by logging in to TopLogger in a browser and copying the refresh
# token from devtools — logging in is manual by design, it needs a reCAPTCHA.
#
# Why you delete it: the refresh token ROTATES. Every run exchanges it for a new
# one and the old one dies, so the value you paste here is stale after the first
# successful run. The keychain holds the current one from then on; nothing ever
# writes back to this file.
#
# TOPLOGGER_REFRESH_TOKEN=
