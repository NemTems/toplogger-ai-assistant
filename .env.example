# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# NO TOKENS IN THIS FILE, or in .env.
# Access and refresh tokens live only in the OS keychain via `keyring`
# (AGENTS.md hard rule 1). If you find yourself pasting a token here, stop —
# it belongs in the keychain, and Phase 1 adds the command that puts it there.
# This file holds non-secret configuration only.

# Gym to sync. Defaults to Falkors, whose ID is already public in
# docs/PROJECT_CONTEXT.md. Override to point at a different gym.
TOPLOGGER_GYM_ID=6k5d6kkbrp6y4rqmj84ip

# Your own TopLogger user ID, needed for the authenticated history sync.
# Personal data: it has no default in config.py and must stay out of git.
# TOPLOGGER_USER_ID=

# Max requests/second to TopLogger. 1.0 is a hard ceiling, not a suggestion —
# config.py rejects anything above it (politeness rule). Lower is fine.
TOPLOGGER_RATE_LIMIT_PER_SECOND=1.0

# Where raw snapshots and the SQLite DB live, relative to the repo root.
# Gitignored; never commit its contents.
TOPLOGGER_DATA_DIR=data
